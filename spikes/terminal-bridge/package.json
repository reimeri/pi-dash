    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/xterm": "6.0.0",
    "fastify": "5.11.0",
    "node-pty": "1.1.0",
    "svelte": "5.55.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.58.2",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/node": "24.10.13",
    "@types/ws": "8.18.1",
    "eslint": "9.39.2",
    "eslint-plugin-svelte": "3.14.0",
    "globals": "17.3.0",
    "svelte-check": "4.4.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
